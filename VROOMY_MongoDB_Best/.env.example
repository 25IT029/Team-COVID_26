PORT=5000
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/vroomy
JWT_SECRET=replace_with_a_long_random_secret
# Free Resend test-email setup. Keep real values only in .env, never commit them.
RESEND_API_KEY=re_your_resend_api_key
TEST_EMAIL=your_resend_account_email@example.com
# Optional after verifying a sending domain in Resend:
# EMAIL_FROM=VROOMY <notifications@your-domain.com>
